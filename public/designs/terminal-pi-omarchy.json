{
  "$schema": "https://luongnv.com/sleek-ui/schema/design.v1.json",
  "name": "terminal-pi-omarchy",
  "version": "1.0.0",
  "description": "Omarchy terminal theme extracted from the original Pi theme, preserving its UI palette and syntax colors.",
  "categories": [
    "terminal",
    "dark"
  ],
  "collection": "terminal",
  "appTargets": [
    "pi",
    "ghostty",
    "iterm2",
    "warp"
  ],
  "author": {
    "name": "pi-extensions",
    "url": "https://github.com/luongnv89/pi-extensions"
  },
  "tokens": {
    "colors": {
      "light": {
        "background": "0 0% 100%",
        "foreground": "240 10% 3.9%",
        "muted": "240 4.8% 95.9%",
        "muted-foreground": "240 3.8% 46.1%",
        "primary": "156 100% 50%",
        "primary-foreground": "0 0% 100%",
        "secondary": "240 4.8% 95.9%",
        "secondary-foreground": "240 10% 3.9%",
        "accent": "195 100% 60%",
        "accent-foreground": "240 10% 3.9%",
        "destructive": "0 32% 49%",
        "destructive-foreground": "0 0% 100%",
        "border": "240 5.9% 90%",
        "input": "240 5.9% 90%",
        "ring": "156 100% 50%",
        "card": "0 0% 100%",
        "card-foreground": "240 10% 3.9%"
      },
      "dark": {
        "background": "204 14% 7%",
        "foreground": "180 2% 80%",
        "muted": "207 12% 15%",
        "muted-foreground": "210 7% 47%",
        "primary": "156 100% 50%",
        "primary-foreground": "204 14% 7%",
        "secondary": "207 12% 15%",
        "secondary-foreground": "180 2% 80%",
        "accent": "195 100% 60%",
        "accent-foreground": "204 14% 7%",
        "destructive": "0 32% 49%",
        "destructive-foreground": "204 14% 7%",
        "border": "203 8% 33%",
        "input": "205 9% 26%",
        "ring": "156 100% 50%",
        "card": "206 13% 11%",
        "card-foreground": "180 2% 80%"
      }
    },
    "typography": {
      "fontFamily": {
        "sans": "Inter",
        "serif": "Georgia",
        "mono": "JetBrains Mono"
      },
      "fontSize": {
        "xs": "0.75rem",
        "sm": "0.875rem",
        "base": "1rem",
        "lg": "1.125rem",
        "xl": "1.25rem",
        "2xl": "1.5rem",
        "3xl": "1.875rem",
        "4xl": "2.25rem"
      },
      "fontWeight": {
        "normal": 400,
        "medium": 500,
        "semibold": 600,
        "bold": 700
      },
      "lineHeight": {
        "tight": "1.25",
        "normal": "1.5",
        "relaxed": "1.625"
      },
      "letterSpacing": {
        "tight": "-0.025em",
        "normal": "0",
        "wide": "0.025em"
      }
    },
    "spacing": {
      "unit": "8px",
      "xs": "4px",
      "sm": "8px",
      "md": "16px",
      "lg": "24px",
      "xl": "32px",
      "2xl": "48px"
    },
    "radius": {
      "sm": "0.125rem",
      "default": "0.375rem",
      "lg": "0.5rem",
      "full": "9999px"
    },
    "shadows": {
      "sm": "0 1px 2px 0 rgb(0 0 0 / 0.05)",
      "default": "0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)",
      "lg": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)"
    }
  },
  "fonts": {
    "google": [
      {
        "family": "JetBrains Mono",
        "weights": [
          400,
          500,
          600,
          700
        ]
      }
    ],
    "urls": [
      {
        "url": "https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap",
        "format": "css2",
        "family": "JetBrains Mono"
      }
    ]
  },
  "accessibility": {
    "contrastTarget": 4.5,
    "focusRing": {
      "width": "2px",
      "color": "currentColor",
      "offset": "2px"
    },
    "reducedMotion": true
  },
  "components": {
    "button": {
      "primary": {
        "background": "primary",
        "color": "primary-foreground",
        "borderRadius": "radius.default",
        "padding": "spacing.sm spacing.md",
        "fontWeight": "semibold"
      },
      "secondary": {
        "background": "secondary",
        "color": "secondary-foreground",
        "borderRadius": "radius.default",
        "padding": "spacing.sm spacing.md",
        "fontWeight": "medium"
      },
      "ghost": {
        "background": "transparent",
        "color": "foreground",
        "borderRadius": "radius.default",
        "padding": "spacing.sm spacing.md",
        "fontWeight": "medium"
      }
    },
    "card": {
      "background": "card",
      "color": "card-foreground",
      "borderRadius": "radius.lg",
      "padding": "spacing.lg",
      "shadow": "shadows.default",
      "border": "1px solid border"
    },
    "input": {
      "background": "background",
      "color": "foreground",
      "borderRadius": "radius.default",
      "padding": "spacing.sm spacing.md",
      "border": "1px solid input",
      "focusRing": "focusRing",
      "placeholderColor": "muted-foreground"
    }
  },
  "tokenColors": [
    {
      "scope": "comment",
      "color": "0 0% 33%",
      "fontStyle": "italic"
    },
    {
      "scope": "keyword",
      "color": "195 100% 60%"
    },
    {
      "scope": "function",
      "color": "195 100% 60%"
    },
    {
      "scope": "variable",
      "color": "156 100% 50%"
    },
    {
      "scope": "string",
      "color": "156 100% 50%"
    },
    {
      "scope": "number",
      "color": "23 46% 48%"
    },
    {
      "scope": "type",
      "color": "195 100% 60%"
    },
    {
      "scope": "operator",
      "color": "195 100% 60%"
    },
    {
      "scope": "punctuation",
      "color": "210 7% 47%"
    }
  ],
  "agentInstructions": {
    "defaultMode": "dark",
    "steps": [
      "Set CSS custom properties from tokens.colors on :root (light) and .dark (dark mode)",
      "Map tokenColors scopes to the target terminal ANSI palette",
      "Load JetBrains Mono from fonts.urls and use it as the primary monospace font",
      "Apply component styles from the components field",
      "Ensure focus states match accessibility.focusRing specification",
      "Test both light and dark modes"
    ]
  },
  "preview": {
    "thumbnail": "/previews/terminal-pi-omarchy-thumb.svg"
  },
  "source": {
    "repo": "https://github.com/luongnv89/pi-extensions",
    "path": "themes/omarchy.json"
  }
}
